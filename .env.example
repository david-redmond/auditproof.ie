# Required for all environments
AUTH_SECRET=replace-with-at-least-32-char-random-string
MONGODB_URI=mongodb://localhost:27017/vault
BOOTSTRAP_TOKEN=replace-with-one-time-setup-token

# Public URL (sitemap, canonical URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Analytics (optional – leave unset to disable)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_HOTJAR_ID=1234567

# Optional: invite link base (defaults to NEXT_PUBLIC_SITE_URL if unset)
# VAULT_BASE_URL=https://your-domain.com
# NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Stripe (required only when ENABLE_PAYMENTS=true)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ANNUAL=price_...
STRIPE_PRICE_MONTHLY=price_...
# Display prices shown on pricing page and paywall (numbers only, e.g. 179 and 18)
STRIPE_PRICE_ANNUAL_NUMBER=179
STRIPE_PRICE_MONTHLY_NUMBER=18
ENABLE_PAYMENTS=true

# Resend (invite, partner, and contact form emails)
RESEND_FROM=noreply@your-domain.com
# Contact form sender (required for /api/contact)
RESEND_FROM_EMAIL=noreply@your-domain.com
RESEND_API_KEY=re_...
PARTNER_NOTIFY_EMAIL=notifications@your-domain.com

# Optional: E2E partner test – send partner signup notifications to a Mailtrap inbox and assert the email arrived.
# 1. Create a Mailtrap inbox (Email Testing / Sandbox). 2. Set PARTNER_NOTIFY_EMAIL to that inbox’s receiving address.
# 3. Add these so the partner E2E test can read the latest message and assert content.
#
# Where to find in Mailtrap:
#   MAILTRAP_API_TOKEN  → Mailtrap → Settings (gear) → API Tokens → create/copy a token (needs Email Testing / Sandbox access).
#   MAILTRAP_ACCOUNT_ID → In the app URL when you open an inbox: .../accounts/{account_id}/inboxes/... (the number after "accounts/").
#   MAILTRAP_INBOX_ID   → Same URL: .../inboxes/{inbox_id}/... (the number after "inboxes/"). Or: Email Testing → your inbox → Settings → "Inbox ID" / API section.
#
# MAILTRAP_API_TOKEN=your-token
# MAILTRAP_ACCOUNT_ID=12345
# MAILTRAP_INBOX_ID=67890
